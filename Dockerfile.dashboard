# ============================================================
# Dockerfile for Streamlit Dashboard
# Hospital Readmission Analytics and Prediction
# ============================================================

FROM python:3.11-slim

LABEL maintainer="Student - Data Engineering and MLOps"
LABEL description="Streamlit analytics dashboard for hospital readmission"

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies (only what dashboard needs)
RUN pip install --no-cache-dir \
    streamlit==1.35.0 \
    plotly==5.22.0 \
    pandas==2.2.2 \
    numpy==1.26.4 \
    sqlalchemy==2.0.30 \
    psycopg2-binary==2.9.9 \
    python-dotenv==1.0.1 \
    pyyaml==6.0.1

# Copy application files
COPY dashboard/ ./dashboard/
COPY src/ ./src/
COPY config/ ./config/

# Expose Streamlit port
EXPOSE 8501

# Streamlit config for running inside Docker
ENV STREAMLIT_SERVER_HEADLESS=true
ENV STREAMLIT_SERVER_ADDRESS=0.0.0.0
ENV STREAMLIT_SERVER_PORT=8501

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "dashboard/app.py", "--server.port=8501", "--server.address=0.0.0.0"]
