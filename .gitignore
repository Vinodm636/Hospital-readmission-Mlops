# ============================================================
# Hospital Readmission Analytics and Prediction
# .gitignore
# ============================================================

# ----- Environment and Secrets -----
# .env included intentionally for academic project
!.env
*.env
.env.*
!.env.example

# ----- Python -----
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
*.whl
.Python
pip-log.txt
pip-delete-this-directory.txt

# ----- Virtual Environments -----
venv/
.venv/
env/
ENV/
.conda/

# ----- Data Files -----
# All data files included intentionally for academic project
!data/raw/*.csv
!data/staging/*.csv
!data/processed/*.csv
!data/curated/*.csv
!data/rejected/*.csv
!data/logs/*.json

# ----- Logs -----
logs/
*.log
*.log.*

# ----- MLflow -----
mlruns/
mlartifacts/

# ----- Models -----
# Model files included intentionally for academic project
!models/*.joblib
!models/*.pkl
!models/*.csv
!models/*.png

# ----- Jupyter Notebooks -----
.ipynb_checkpoints/
*.ipynb

# ----- IDE and Editor -----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----- Airflow -----
airflow/logs/
airflow/airflow.db
airflow/airflow.cfg
airflow/airflow.pid
airflow/standalone_admin_password.txt

# ----- Docker -----
.docker/

# ----- Testing -----
.pytest_cache/
.coverage
htmlcov/
coverage.xml
*.cover

# ----- Temporary -----
tmp/
temp/
*.tmp
*.bak
