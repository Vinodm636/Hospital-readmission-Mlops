# ============================================================
# Hospital Readmission Analytics and Prediction
# Environment Variables Template
#
# INSTRUCTIONS:
#   1. Copy this file to .env
#      cp .env.example .env   (Linux/Mac)
#      Copy-Item .env.example .env   (Windows PowerShell)
#   2. Fill in your actual values in .env
#   3. NEVER commit .env to version control
#   4. .env is listed in .gitignore
# ============================================================

# ----- PostgreSQL Database -----
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hospital_readmission
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# Full connection string (alternative to individual vars above)
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/hospital_readmission

# ----- MLflow -----
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=hospital_readmission_prediction

# ----- Airflow -----
AIRFLOW_HOME=./airflow
AIRFLOW__CORE__EXECUTOR=SequentialExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=sqlite:///./airflow/airflow.db
AIRFLOW__CORE__LOAD_EXAMPLES=False

# ----- Project Paths -----
PROJECT_ROOT=.
DATA_RAW_PATH=./data/raw
DATA_STAGING_PATH=./data/staging
DATA_PROCESSED_PATH=./data/processed
DATA_CURATED_PATH=./data/curated
DATA_REJECTED_PATH=./data/rejected
DATA_LOGS_PATH=./data/logs
LOGS_PATH=./logs
MODELS_PATH=./models

# ----- Dataset -----
DATASET_FILE_NAME=diabetic_data.csv
DATASET_IDS_MAP_FILE=IDS_mapping.csv

# ----- FastAPI -----
API_HOST=0.0.0.0
API_PORT=8000

# ----- Streamlit -----
STREAMLIT_PORT=8501
